# escape=`

FROM mcr.microsoft.com/dotnet/sdk:9.0-windowsservercore-ltsc2025 AS build

WORKDIR C:\src

# Copy project file first so restore can be cached
COPY AvaloniaApplication1\AvaloniaApplication1.csproj .\AvaloniaApplication1\

RUN dotnet restore .\AvaloniaApplication1\AvaloniaApplication1.csproj

# Copy the rest of the source
COPY AvaloniaApplication1 .\AvaloniaApplication1

WORKDIR C:\src\AvaloniaApplication1

RUN dotnet publish `
    AvaloniaApplication1.csproj `
    --configuration Release `
    --runtime win-x64 `
    --self-contained false `
    --output C:\publish


FROM mcr.microsoft.com/dotnet/runtime:9.0-windowsservercore-ltsc2025 AS runtime

WORKDIR C:\app

COPY --from=build C:\publish .

ENTRYPOINT ["dotnet", "AvaloniaApplication1.dll"]