FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY ["AvaloniaApplication1/AvaloniaApplication1.csproj", "AvaloniaApplication1/"]
RUN dotnet restore "AvaloniaApplication1/AvaloniaApplication1.csproj"
COPY . .
WORKDIR /src/AvaloniaApplication1
RUN dotnet publish "AvaloniaApplication1.csproj" -c Release -o /app/publish \
    --runtime linux-x64 --self-contained true

FROM mcr.microsoft.com/dotnet/runtime:9.0 AS final

# Install Avalonia dependencies and Xvfb
RUN apt-get update && apt-get install -y \
    libx11-6 \
    libice6 \
    libsm6 \
    libfontconfig1 \
    xvfb \
    fonts-noto \
    && fc-cache -fv \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

ENV DISPLAY=:99

WORKDIR /app
COPY --from=build /app/publish .
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["./AvaloniaApplication1"]